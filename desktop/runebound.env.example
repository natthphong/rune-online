# Copy to "runebound.env" next to the app (or into the data folder) to change how the desktop app runs.
# No file = simple mode (embedded database, nothing to install).

# --- install mode: use your own PostgreSQL + Redis ---
# RO_STORE=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/home
# REDIS_URL=redis://localhost:6379
# DB_SCHEMA=ro            # Postgres schema the game owns (created on first start)
# REDIS_PREFIX=ro:        # prefix for every Redis key

# --- both modes ---
# PORT=2680               # default: first free port in 2680-2689
# HOST=0.0.0.0            # default 127.0.0.1 in simple mode (this computer only), 0.0.0.0 in install mode (LAN)
